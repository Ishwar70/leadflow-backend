# MongoDB Atlas connection string (must be a replica set - all Atlas clusters are)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/leadflow?retryWrites=true&w=majority

# Long random string used to sign session tokens (openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin(s), comma separated. Used for CORS and links in emails.
FRONTEND_URL=http://localhost:3000

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/reminders
CRON_SECRET=replace-with-another-random-secret

# Enables one-click demo logins (POST /api/auth/demo). Run `npm run seed` first.
DEMO_MODE=true

# Optional: transactional email via Resend (invites, password reset, web-form welcome)
RESEND_API_KEY=
EMAIL_FROM=LeadFlow CRM <onboarding@resend.dev>

PORT=4000
